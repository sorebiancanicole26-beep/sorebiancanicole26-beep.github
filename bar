<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My BSIT Portfolio</title>
    
    <!-- Dito mo ilalagay ang CSS Code sa loob ng <style> tag -->
    <style>
        /* Estilo para sa buong Navbar */
        .navbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background-color: #ffffff; /* Minimalist Light Theme background */
            padding: 20px 50px;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            z-index: 1000;
        }

        /* Estilo para sa Logo / Pangalan mo */
        .logo a {
            font-size: 22px;
            font-weight: bold;
            color: #333333;
            text-decoration: none;
        }

        /* Estilo para sa mga Links (pahalang na ayos) */
        .nav-links {
            list-style: none;
            display: flex;
            gap: 30px;
            margin: 0;
            padding: 0;
        }

        /* Estilo sa mga text ng links */
        .nav-links li a {
            text-decoration: none;
            color: #555555;
            font-size: 16px;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        /* Epekto kapag itinapat ang mouse */
        .nav-links li a:hover {
            color: #007bff;
        }

        /* Pampasagana lang para makita ang scrolling effect */
        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background-color: #f9f9f9;
        }
        section {
            padding: 100px 50px;
            height: 100vh;
        }
    </style>
</head>
<body>

    <!-- Dito naman ang HTML Code ng Navbar -->
    <nav class="navbar">
        <div class="logo">
            <a href="#home">MyPortfolio</a>
        </div>
        <ul class="nav-links">
            <li><a href="#home">Home</a></li>
            <li><a href="#about">About Me</a></li>
            <li><a href="#skills">Skills</a></li>
            <li><a href="#projects">Projects</a></li>
            <li><a href="#contact">Contact</a></li>
        </ul>
    </nav>

    <!-- Mga Section para masubukan ang links -->
    <section id="home"><h1>Home Section</h1></section>
    <section id="about"><h1>About Me Section</h1></section>
    <section id="skills"><h1>Skills Section</h1></section>
    <section id="projects"><h1>Projects Section</h1></section>
    <section id="contact"><h1>Contact Section</h1></section>

</body>
</html>
